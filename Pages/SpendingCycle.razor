    <table class="guide-table">
        <thead>
            <tr><th>開催予想</th><th>状態</th></tr>
        </thead>
        <tbody>
            @foreach (var row in AllianceMobilizationInfo.ScheduleRows())
            {
                <tr class="@(string.IsNullOrEmpty(row.Label) ? "" : "guide-table-total")">
                    <td>@AllianceMobilizationInfo.FormatRangeLong(row.Start, row.End)</td>
                    <td>@row.Label</td>
                </tr>
            }
        </tbody>
    </table>
