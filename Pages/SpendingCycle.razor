            <tr><td>火曜</td><td>マスターの叡智</td></tr>
            <tr><td>水曜</td><td>宝石系</td></tr>
            <tr><td>木曜</td><td>兵装セレクト</td></tr>
            <tr><td>金曜</td><td>領主装備・希望市場</td></tr>
            <tr><td>土曜</td><td>固定の主力パック少なめ</td></tr>
