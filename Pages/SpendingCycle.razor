<RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-4">🗓️ 実際の日付で見る課金スケジュール</RadzenText>
<div class="cycle-flow">
    @{ var cycles = AllianceMobilizationInfo.UpcomingCycles(3); }
