    {
        var c = cycles[i];
        <div class="cycle-card cycle-card-accent-gold">
            <div class="cycle-card-title">💰 同盟総動員で追加課金</div>
            <p class="cycle-card-desc">@AllianceMobilizationInfo.FormatRange(c.MobStart, c.MobEnd)</p>
