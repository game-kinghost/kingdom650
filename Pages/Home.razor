<RadzenCard class="rz-my-4">
    <RadzenText TextStyle="TextStyle.Subtitle1">炎竜イベント参考動画</RadzenText>
    <div class="video-embed">
        <iframe src="https://www.youtube.com/embed/fe859w3Ruf0"
                title="炎竜イベント参考動画"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen></iframe>
    </div>
    <RadzenText TextStyle="TextStyle.Body1" class="rz-mt-2">
        他の参考動画は <NavLink href="/videos">動画ページ</NavLink> にまとめています。
    </RadzenText>

    <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-mt-4">秘境の試練</RadzenText>
    <RadzenText TextStyle="TextStyle.Body1">以下サイト参考に！</RadzenText>
    <a href="https://ks.h5joy-games.com/ja/guides/mystic-trial-guide/" target="_blank" rel="noopener noreferrer">
        秘境の試練 攻略ガイド (h5joy-games.com)
    </a>
</RadzenCard>

<RadzenText TextStyle="TextStyle.H5" class="rz-mt-4">注目コンテンツ</RadzenText>
