@inherits LayoutComponentBase

<RadzenComponents />

<header class="site-header">
    <div class="site-header-top">
        <div class="site-brand">
            <div class="site-logo">K</div>
            <div class="site-brand-text">
                <h1>Kingshot 650王国</h1>
                <p>650王国の非公式紹介サイト</p>
            </div>
        </div>
    </div>
    <div class="site-nav">
        <div class="site-nav-inner">
            <button type="button" class="nav-toggle" aria-label="メニューを開く" aria-expanded="@navOpen" @onclick="ToggleNav">
                <span class="nav-toggle-icon">☰</span>
            </button>
            <div class="site-nav-collapsible @(navOpen ? "nav-open" : "")">
                <NavMenu OnNavigate="CloseNav" />
                <div class="site-search">
                    <input type="search" placeholder="サイト内検索(準備中)" aria-label="サイト内検索" disabled />
                    <button type="button" aria-label="検索" disabled>🔍</button>
                </div>
            </div>
        </div>
    </div>
</header>

@code {
    private bool navOpen;

    private void ToggleNav() => navOpen = !navOpen;

    private void CloseNav() => navOpen = false;
}

<div class="page-content">
    <div class="site-layout">
        <main class="site-main">
            @Body
        </main>
        <aside class="site-aside">
            <div class="widget-box">
                <h4>Social</h4>
                <div class="widget-body">
                    <ul>
                        <li><a href="https://www.kingshot.com/ja" target="_blank" rel="noopener noreferrer">公式サイト</a></li>
                        <li><a href="https://www.kingshot.wiki/" target="_blank" rel="noopener noreferrer">Kingshot Wiki</a></li>
                        <li><a href="https://centurygames.helpshift.com/hc/ja/140-kingshot/" target="_blank" rel="noopener noreferrer">Kingshotヘルプセンター</a></li>
                        <li><a href="https://discord.gg/kingshot" target="_blank" rel="noopener noreferrer">公式Discordサーバー</a></li>
                        <li><a href="https://x.com/Kingshot_JP?lang=ja" target="_blank" rel="noopener noreferrer">公式X</a></li>
                    </ul>
                </div>
            </div>
            <div class="widget-box widget-box-nav">
                <h4>🧭 Navigate</h4>
                <div class="widget-body">
                    <ul>
                        <li><NavLink href="" Match="NavLinkMatch.All"><span class="widget-nav-icon">🏠</span>トップ</NavLink></li>
                        <li><NavLink href="kvk"><span class="widget-nav-icon">👑</span>KvK戦況</NavLink></li>
                        <li><NavLink href="alliance"><span class="widget-nav-icon">🤝</span>同盟</NavLink></li>
                        <li><NavLink href="generation"><span class="widget-nav-icon">🎖️</span>英雄世代</NavLink></li>
                        <li><NavLink href="cycle"><span class="widget-nav-icon">💰</span>課金サイクル</NavLink></li>
                        <li><NavLink href="strategy"><span class="widget-nav-icon">📊</span>育成順位</NavLink></li>
                        <li class="widget-submenu-item"><a href="strategy#rank-1">⚔️ 英雄</a></li>
                        <li class="widget-submenu-item"><a href="strategy#rank-2">🛡️ 英雄装備</a></li>
                        <li class="widget-submenu-item"><a href="strategy#rank-3">🔬 科学研究</a></li>
                        <li class="widget-submenu-item"><a href="strategy#rank-4">👑 マスター</a></li>
                        <li class="widget-submenu-item"><a href="strategy#rank-5">🐾 ペット</a></li>
                        <li class="widget-submenu-item"><a href="strategy#rank-6">🏰 領主装備</a></li>
                        <li class="widget-submenu-item"><a href="strategy#rank-7">🏝️ 島</a></li>
                        <li><NavLink href="events"><span class="widget-nav-icon">🎉</span>イベント</NavLink></li>
                        <li class="widget-submenu-item"><a href="events#swordland">⚔️ 聖剣争奪</a></li>
                        <li class="widget-submenu-item"><a href="events#bear">🐻 熊</a></li>
                        <li class="widget-submenu-item"><a href="events#mystic-trial">🏛️ 秘境の試練</a></li>
                        <li><NavLink href="combat"><span class="widget-nav-icon">⚔️</span>戦闘計算</NavLink></li>
                        <li><NavLink href="videos"><span class="widget-nav-icon">🎬</span>動画</NavLink></li>
                        <li><NavLink href="pcplay"><span class="widget-nav-icon">💻</span>PC版</NavLink></li>
                    </ul>
                </div>
            </div>
        </aside>
    </div>
</div>

<footer class="site-footer">
    <div class="site-footer-links">
        <NavLink href="" Match="NavLinkMatch.All">トップ</NavLink>
        <NavLink href="kvk">KvK戦況</NavLink>
        <NavLink href="alliance">同盟</NavLink>
        <NavLink href="generation">英雄世代</NavLink>
        <NavLink href="cycle">課金サイクル</NavLink>
        <NavLink href="strategy">育成順位</NavLink>
        <NavLink href="events">イベント</NavLink>
        <a href="events#bear">熊</a>
        <NavLink href="combat">戦闘計算</NavLink>
        <NavLink href="videos">動画</NavLink>
        <NavLink href="pcplay">PC版</NavLink>
    </div>
    <p>Copyright Kingshot 650王国紹介サイト. 本サイトは非公式のファンサイトです。</p>
</footer>
